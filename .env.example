# Behold AI-First Content System — Environment Variables
# Copy this file to .env and fill in your values

# === REQUIRED ===
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL: Enhanced Listeners ===
# YouTube Data API (free via Google Cloud Console)
YOUTUBE_API_KEY=

# Reddit API (free via reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BeholdContentSystem/1.0

# === OPTIONAL: Monitoring ===
# Google Search Console API
GOOGLE_SEARCH_CONSOLE_SITE=

# === OPTIONAL: Publishing ===
# WordPress REST API (for draft-to-staging)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# === SERVER ===
PORT=3000
NODE_ENV=development
