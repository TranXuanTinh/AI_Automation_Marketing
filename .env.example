# Behold AI-First Content System — Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# 🤖 AI LLM PROVIDER CONFIGURATION
# ==============================================================================
# Hỗ trợ linh hoạt:
# 1. Google Gemini Native: Cung cấp GEMINI_API_KEY (AIzaSy...)
# 2. Bất kỳ Custom OpenAI-Compatible LLM nào (NVIDIA NIM, DeepSeek, Ollama, vLLM, XFTOKEN):
#    Cung cấp XFTOKEN_API_KEY và XFTOKEN_BASE_URL (kèm XFTOKEN_MODEL)

# Tùy chọn 1: Custom AI API / OpenAI-Compatible / NVIDIA NIM (Khuyến nghị nếu có key nvapi-...)
XFTOKEN_API_KEY=
XFTOKEN_BASE_URL=https://integrate.api.nvidia.com/v1
XFTOKEN_MODEL=meta/llama-3.1-70b-instruct

# Tùy chọn 2: Google Gemini API (Từ aistudio.google.com)
GEMINI_API_KEY=

# ==============================================================================
# 🎧 OPTIONAL: Enhanced Listeners
# ==============================================================================
# YouTube Data API (free via Google Cloud Console)
YOUTUBE_API_KEY=

# Reddit API (free via reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BeholdContentSystem/1.0
ENABLE_REDDIT=false

# ==============================================================================
# 🕷️ OPTIONAL: CRW Web Scraper (https://github.com/us/crw)
# ==============================================================================
# Self-hosted (recommended): curl -fsSL https://fastcrw.com/install | sh
# Then run: crw (starts on http://localhost:3000)
# Cloud: get free key at https://fastcrw.com/register
CRW_API_KEY=
CRW_BASE_URL=http://localhost:3000

# ==============================================================================
# 📊 OPTIONAL: Monitoring & Server
# ==============================================================================
GOOGLE_SEARCH_CONSOLE_SITE=
PORT=3000
NODE_ENV=development
