# Behold AI-First Content System — Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# 🤖 AI LLM PROVIDER CONFIGURATION
# ==============================================================================
# Hỗ trợ 3 tùy chọn AI linh hoạt (chỉ cần chọn 1 trong 3):
# 1. ChatGPT / OpenAI API (Khuyến nghị cho tài khoản OpenAI):
#    Lấy API key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1 # Mặc định, có thể bỏ trống

# 2. Google Gemini Native API:
#    Lấy API key tại: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. Custom OpenAI-Compatible LLM (NVIDIA NIM, DeepSeek, Ollama, vLLM, XFTOKEN):
# XFTOKEN_API_KEY=nvapi-...
# XFTOKEN_BASE_URL=https://integrate.api.nvidia.com/v1
# XFTOKEN_MODEL=meta/llama-3.1-70b-instruct

# ==============================================================================
# 🎧 OPTIONAL: Enhanced Listeners
# ==============================================================================
# YouTube Data API (free via Google Cloud Console)
YOUTUBE_API_KEY=

# Reddit API (free via reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BeholdContentSystem/1.0
ENABLE_REDDIT=false

# ==============================================================================
# 🕷️ OPTIONAL: CRW Web Scraper (https://github.com/us/crw)
# ==============================================================================
# Self-hosted (recommended): curl -fsSL https://fastcrw.com/install | sh
# Then run: crw (starts on http://localhost:3000)
# Cloud: get free key at https://fastcrw.com/register
CRW_API_KEY=
CRW_BASE_URL=http://localhost:3000

# ==============================================================================
# 📊 OPTIONAL: Monitoring & Server
# ==============================================================================
GOOGLE_SEARCH_CONSOLE_SITE=
PORT=3000
NODE_ENV=development
